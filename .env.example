# Modèle du fichier .env : je le copie en .env, puis je remplis les valeurs.
# Le fichier .env reste sur mon poste : il est ignoré par Git et ne contient
# jamais de valeur versionnée. Ce modèle, lui, est versionné et ne contient
# aucun secret.

# Environnement d'exécution : development, test ou production.
APP_ENV=development

# Niveau de détail des journaux : DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO

# Base PostgreSQL. Depuis mon poste, elle répond sur 127.0.0.1 ; dans Docker
# Compose, les conteneurs utilisent d'eux-mêmes l'adresse « db ». Je n'écris pas
# localhost : sous Windows, il essaie d'abord l'adresse IPv6, où Docker ne
# publie pas la base, et la connexion reste bloquée.
# Port 5433 : Docker publie la base sur ce port du poste, le 5432 étant déjà pris
# par le PostgreSQL installé sous Windows. Les conteneurs, eux, utilisent 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=p5

# Rôle propriétaire : il crée les tables et insère le jeu de données.
POSTGRES_USER=proprietaire
POSTGRES_PASSWORD=

# Rôle de l'API : il lit et ajoute des traces, sans pouvoir modifier ni supprimer.
POSTGRES_API_USER=api
POSTGRES_API_PASSWORD=

# Je génère chaque mot de passe (lettres et chiffres seulement) par :
#     uv run python -c "import secrets; print(secrets.token_hex(16))"
